# Application Configuration
APP_NAME="Document Processing & Question Extraction Service"
APP_ENV=development
APP_DEBUG=true
API_V1_STR=/api/v1
HOST=0.0.0.0
PORT=8000

# CORS Origins (comma-separated or JSON list)
FRONTEND_URL=http://localhost:5173
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","https://your-frontend.vercel.app"]

# Security / JWT (generate with: openssl rand -hex 32)
SECRET_KEY=change_this_to_a_secure_random_string_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# Database Configuration (PostgreSQL / Render Postgres)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=doc_processing_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/doc_processing_db

# Redis & Celery Configuration (Render Redis / Key-Value)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Storage Configuration (local or s3)
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./data/uploads
MAX_UPLOAD_SIZE_BYTES=52428800 # 50 MB
ALLOWED_MIME_TYPES=["application/pdf","image/jpeg","image/png","image/jpg"]

# S3 Compatible Object Storage (Optional for S3/R2/MinIO)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# OCR Configuration
OCR_PROVIDER=tesseract
TESSERACT_CMD=tesseract
OCR_FALLBACK_CONFIDENCE_THRESHOLD=0.60
OCR_PAGE_DENSITY_THRESHOLD=50 # Characters per page below which OCR is triggered

# Question Extraction & Confidence Thresholds
EXTRACTION_ENGINE=rule_based
CONFIDENCE_HIGH_THRESHOLD=0.85
CONFIDENCE_MEDIUM_THRESHOLD=0.60
CONFIDENCE_REVIEW_THRESHOLD=0.60

# External AI Provider (Optional: Gemini / OpenAI / Claude)
AI_PROVIDER_ENABLED=false
AI_PROVIDER_NAME=gemini
AI_API_KEY=
AI_MODEL_NAME=gemini-1.5-flash
